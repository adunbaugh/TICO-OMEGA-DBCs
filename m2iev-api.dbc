CM_ SG_ 256 EVTargetCurrent "Current to be supplied by EVSE";
CM_ SG_ 256 RemainingTimeToFullSoC "Time left until charging complete";
CM_ SG_ 256 RemainingTimeToBulkSoC "Time left until bulk charging complete";
CM_ SG_ 257 ResponseCode "Response code from EVSE";
CM_ SG_ 257 EVSECurrentLimitAchieved "Indicator that EVSE is in current limiting mode";
