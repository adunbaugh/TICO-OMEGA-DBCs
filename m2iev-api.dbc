CM_ SG_ 257 EVSEPowerLimitAchieved "Indicator that EVSE is in power limiting mode";
CM_ SG_ 257 EVSEStatusCode "Status code reported by EVSE";
CM_ SG_ 257 EVSEIsolationStatus "Isolation status detected by EVSE";
CM_ SG_ 257 EVSEPresentVoltage "Voltage supplied by EVSE (read on EVSE side)";
CM_ SG_ 257 EVSEPresentCurrent "Current supplied by EVSE (read on EVSE side)";
CM_ SG_ 259 EVSEMaxCurrent "Maximum current EV may draw from EVSE";
CM_ SG_ 260 TemperatureDC1HighAlarm "Temperature on DC+ terminal >=80 degC";
