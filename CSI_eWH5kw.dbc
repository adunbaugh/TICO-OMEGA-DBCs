 SG_ PTC_ErrLevel : 40|8@1+ (1,0) [0|3] "enum" Vector__XXX
 SG_ PTC_RunningCurrent : 48|8@1+ (1,0) [0|255] "A" Vector__XXX
 SG_ PTC_HVDCVlts : 56|8@1+ (1,0) [0|255] "V" Vector__XXX



CM_ SG_ 2147484264 PTC_PowerRatio "0-10%: Stop
11-95%: Proportionally adjusted power
95%+: (96-255) Full power output (no thermal body power output)";
CM_ SG_ 2147484264 TempSetting "Data range: 0 to 85 degree C
Any value that exceeds 85 will cap at 85";
CM_ SG_ 2147484264 PTC_ON_OFF "0: Stop Heating
1: Start heating
";
CM_ SG_ 2147484272 PTC_Power "example: raw reading of 0x32 = 50, 50x100 = 5000w
";
CM_ SG_ 2147484272 TempOfOutWater "Coolant output temperature, offset -40 degC
";
CM_ SG_ 2147484272 PTC_RunStatus "Run Status:
0: Standby
1: Run
2: Invalid
3: Fault";
CM_ SG_ 2147484272 PTC_ErrCode "Bit map:
bit 0 - IGBT fault
bit 1 - over-voltage
bit 2 - under-voltage
bit 3 - NTC is broken
bit 4 - outlet temp too high
bit 5 - dry burning
bit 6 - over-current
bit 7 - reserved";
CM_ SG_ 2147484272 PTC_ErrLevel "0 - normal
1 - minor fault
2 - general fault
3 - critical fault (disconnect HV in this state)";
CM_ SG_ 2147484272 PTC_RunningCurrent "0.2 scaling, max reading 51A
";
CM_ SG_ 2147484272 PTC_HVDCVlts "4 scaling, max VDC 1000V, while run voltage 0-800V
";

