CM_ BU_ VCVCCU "The VCVCCU node";
CM_ SG_ 2566872960 VCVCCU_V2G_NextPMaxValue "Next maximum power value that can be retrieved from the EVSE
value = NextPMaxValue * 10 ^ NextPMaxMultiplier";
CM_ SG_ 2566872960 VCVCCU_V2G_NextPMaxMultiplier "Multiplier used for calculation of next maximum power value: value = NextPMaxValue * 10 ^NextPMaxMultiplier";
CM_ SG_ 2566872704 VCVCCU_V2G_CurrentPMaxMultiplier "Multiplier used for calculation of current maximum power value: value = CurrentPMaxValue * 10 ^ CurrentPMaxMultiplier";
CM_ SG_ 2566872704 VCVCCU_V2G_CurrentPMaxDuration "Time [seconds] left where CurrentPMax value can be retrieved from EVSE.";
CM_ SG_ 2566872704 VCVCCU_V2G_CurrentPMaxValue "Maximum power value that can be retrieved from the EVSE at the moment
value = CurrentPMaxValue * 10 ^ CurrentPMaxMultiplier";
CM_ SG_ 2566840450 TotalVehicleDistance "Accumulated distance traveled by vehicle during its operation.

NOTE See SPN 917 for alternate resolution.

VDV261 parameter Odo";
CM_ SG_ 2566840450 TripDistance "Distance traveled during all or part of a journey.

NOTE See SPN 918 for alternate resolution.";
