CM_ BO_ 3221225472 "This is a message for not used signals, created by Vector CANdb++ DBC OLE DB Provider.";
CM_ SG_ 1813 PFCEnable "PFC Stage enable flag";
CM_ SG_ 1813 LogTempHigh "Thermal Fail flag, True if the Logic temperature is over the maximum level";
CM_ SG_ 1813 LogTempLow "Thermal Fail flag, True if the Logic temperature is under the maximum level";
CM_ SG_ 1813 uvloLog "UVLO (under voltage HV logic) flag";
CM_ SG_ 1813 rx618Fail "RX internal ID618 fail flag";
CM_ SG_ 1813 bulk1_fail "DC bulk1 fail flag";
CM_ SG_ 1813 bulk2_fail "DC bulk2  fail flag";
CM_ SG_ 1813 bulk3_fail "DC bulk3 fail flag";
CM_ SG_ 1813 CoolingFail1 "Cooling fail detected over power stage 1";
CM_ SG_ 1813 CoolingFail2 "Cooling fail detected over power stage 2";
CM_ SG_ 1813 CoolingFail3 "Cooling fail detected over power stage 3";
CM_ SG_ 1813 uvloLogLV "UVLO (under voltage LV logic) flag";
CM_ SG_ 1813 BatOver "True if the voltage of Always hot Battery is over 32Vdc (only when EN61851/SAEJ1772 enabled)";
CM_ SG_ 1813 BatUnder "True if the voltage of Always hot Battery is under 8Vdc (only when EN61851/SAEJ1772 enabled)";
CM_ BO_ 1812 "Tx = 100ms";
CM_ SG_ 1812 TemplogFAN_A "Temperature over Logic Board FAN Supplier Side";
CM_ SG_ 1812 Iout1_A "Output current of channel 1 measured on the HVDC output stage";
CM_ SG_ 1812 Iout2_A "Output current of channel 2  measured on the HVDC output stage";
CM_ SG_ 1812 Iout3_A "Output current of channel 3  measured on the HVDC output stage";
CM_ BO_ 1560 "Tx = 100ms";
CM_ BO_ 1552 "Tx = 1000ms";
CM_ SG_ 1552 PowerEnable "Indicates if the hardware enable pin is active. From 25 July 2016 (serial number ME292830152203) the HVIL signal management is passive. So, it is not still monitored and the flag value is always equal to 1.";
CM_ SG_ 1552 ErrorLatch "If True, a failure or a soft failure has occurred (See the table 1 of Fault Code)";
CM_ SG_ 1552 WarnLimit "If True, a warning condition is present (See the table 1 of Fault Code)";
CM_ SG_ 1552 LimTemp "If True, the de-rating characteristic is active";
CM_ SG_ 1552 WarningHV "If True, the communication with HV side of charger is erratic or the HV side is not powered";
CM_ SG_ 1552 Bulks "If True, a Bulk error is present (See the table 1 of Fault Code)";
CM_ BO_ 1553 "Tx = 100ms";
CM_ SG_ 1553 Iacm "AC Input Current";
CM_ SG_ 1553 Temp "Temperature over Power Stage";
CM_ SG_ 1553 VOut "DC Output Voltage";
CM_ SG_ 1553 IOut "DC Output Current";
CM_ BO_ 1810 "Tx = 100ms";
CM_ SG_ 1810 FANVoltage "DC voltage applied to the FAN (only for EVO11KA)";
CM_ SG_ 1810 Iacm1 "AC Input Current Phase 1";
CM_ SG_ 1810 Iacm3 "AC Input Current Phase 3";
CM_ BO_ 1811 "Tx = 100ms";
CM_ SG_ 1811 LogHV "Temperature over Logic Board HV Side";
CM_ SG_ 1811 Power1 "Temperature over Power Stage 1";
CM_ SG_ 1811 Power2 "Temperature over Power Stage 2
";
CM_ SG_ 1811 Power3 "Temperature over Power Stage 3";
CM_ BO_ 1556 "Tx = 1000ms";
CM_ SG_ 1556 TempLogLV "Temperature over Logic LV Stage";
CM_ SG_ 1556 AcPower "AC input power";
CM_ SG_ 1556 ProxcurrentLimit "It defines the maximum AC input current available considering Proximity Signal (EN61851 only)";
CM_ SG_ 1556 PilotcurrentLimit "It defines the maximum AC input current available considering Pilot Signal";
CM_ BO_ 1557 "Tx = 100ms";
CM_ SG_ 1557 ACok "True if AC Mains is connected (this flag became true a little time before (300ms) the precharge starts)";
CM_ SG_ 1557 PrCompl "True if AC Mains connected and pre-charge completed";
CM_ SG_ 1557 PwrOk "True if the charger starts to provide output power";
CM_ SG_ 1557 Neutral "If T, the Neutral is connected correctly. It is referred to the correct connection of the Neutral in the following AC conf 3 phase star conf ";
CM_ SG_ 1557 LED3 "This flag becomes true when: Tst1.LED618 is True, charger supplied with AC Mains and 12Vdc are provided to the pins 10 and one of 13, 14, 15.";
CM_ SG_ 1557 LED618 "This flag became true when Ctl.lED3 is True. Tst1.LED618 represents an echo of the Ctl.lED3 command. If True, a Led connected to the pins 10 and one of 13, 14, 15 could be powered when AC Mains is provided";
CM_ SG_ 1557 ovp "True if there is a DC output over voltage flag (the overvoltage is referred to the maximum output voltage allowed by the charger range)";
CM_ SG_ 1557 connOpen "Control loop Fail flag (HVIL on DC output connector), true if the output connector is not connected. From 25 July 2016 (serial number ME292830152203) the HVIL signal management is passive. ";
CM_ SG_ 1557 TherFail "If True, the charger is working in de-rating condition (see page 45, chapter 5.12 of the User’s Manual)";
CM_ SG_ 1557 rx618Fail "RX ID618 fail flag, true if the control message is not received for more than 600ms.";
CM_ SG_ 1557 bulk1_fail "If True, a Bulk error related to the channel 1 is present (See the table 1 of Fault Code)";
CM_ SG_ 1557 bulk2_fail "If True, a Bulk error related to the channel 2 is present (See the table 1 of Fault Code)";
CM_ SG_ 1557 PUMPon "True if there is a Pump active request (when Act1.Temp or Act2.TempLogLV value is over 35°C)";
CM_ SG_ 1557 FANon "True if there is a Fan active request (when Act1.Temp or Act2.TempLogLV value is over 40°C)";
CM_ SG_ 1557 HVrxFail "If true, the communication with HV side of charger is erratic";
CM_ SG_ 1557 CoolingFail "If true, the cooling circuit is not connected or the liquid coolant is not present";
CM_ SG_ 1557 Neutro1 "If true, there is a good connection on neutral cable. Tst.1Neutro1 and Tst.1Neutro2 are linked to an internal system that detects the neutral disconnection";
CM_ SG_ 1557 Neutro2 "If true, there is a good connection on neutral cable. Tst.1Neutro1 and Tst.1Neutro2 are linked to an internal system that detects the neutral disconnection";
CM_ SG_ 1557 IacFail "If True, the Iac current value is over the maximum Iac value permitted";
CM_ SG_ 1557 Ignition "If True, the ignition run signal wakes up the charger from SLEEP when SAE J1772 or EN61851 is enabled (see page 29, chapter 5.9.4.2 of the User’s Manual)";
CM_ SG_ 1557 LVBatteryNP "If True, the LV Battery always hot is not present";
CM_ SG_ 1557 ProxOk "True if Proximity level is correct (only when EN61851/SAEJ1772 enabled)";
CM_ SG_ 1557 PilotOk "True if pilot signal is correct (only when EN61851/SAEJ1772 enabled)";
CM_ SG_ 1557 S2Ok "True if S2 is closed (only when EN61851/SAEJ1772 enabled)";
