CM_ BU_ MDC "Magna Driving Controller";
CM_ BO_ 116 "HMI Additional Signals";
CM_ SG_ 116 MDC_SOC "Battery State of Charge Percentage";
CM_ BO_ 114 "MPTvc Signals of Interest";
CM_ BO_ 113 "HMI GUI Status Signals";
CM_ SG_ 113 MDC_ActPRNDL_Status "VCM_Actual_PNDL is generated from OEM controls, Signal sent to VCM, to be forwarded to the HMI via CANbus.";
CM_ SG_ 113 MDC_TCS_Status "This signal is generated within the VCM to update the status of the Traction Control Systems. NOTE: this function is controlled by the OEM Traction Control Button";
CM_ SG_ 113 MDC_LaunchMode_Status "This signal is generated within the VCM to update the status of Launch Mode. NOTE: The Launch Mode initation is contoled by OEM toggle switches";
CM_ SG_ 113 MDC_DemoMode_Status "Controls Creep Mode Requests. Signal Generated within the HMI and shall be sent to the VCM ECU.";
CM_ SG_ 113 MDC_ActDamp_Status "Signal generated in the MDC ECU and is sent to the EDI ECU_FA via CANbus.";
CM_ SG_ 113 MDC_DrvMode_Status "Controls the Driven Motors. Signal Generated from within the HMI and shall be sent to the VCM ECU. ";
CM_ SG_ 113 MDC_CreepMode_Status "Signal Generated within the VCM Model & passed out to the HMI via CANBus. 
";
CM_ BO_ 112 "HMI GUI Control Requests";
CM_ SG_ 112 HMI_BuildNumber "The HMI_BuildNumber is used to confrim that the software loaded into the Main Display matches what the vehicle is expecting";
CM_ SG_ 112 HMI_Major "HMI major build number";
CM_ SG_ 112 HMI_Minor "HMI Minor Build Number";
CM_ SG_ 112 HMI_DemoMode_RQ "HMI_DemomodeRQ shall allow the driver to switch to different pre-determined settings to showcase one or more vehicle atributes.";
CM_ SG_ 112 HMI_RegenMode_RQ "Signal Generated within the HMI and is sent to the VCM ECU. The value table corralates 2 lookup tables that control the strength of regen braking.


";
CM_ SG_ 112 HMI_LoRange_RQ "Signal Generated within the HMI and is sent to the VCM ECU. [0=disabled, 1=enabled](TBD)

";
CM_ SG_ 112 HMI_HndlMode_RQ "Signal Generated within the HMI and is sent to the VCM ECU. The vehicle shall default to auto drive mode upon first start up.";
CM_ SG_ 112 HMI_ActDamp_RQ "Controls Active Damping Requests. Signal Generated from within the HMI and shall be sent to the VCM ECU.";
CM_ SG_ 112 HMI_Avl "HMI_Avl is used for the VCM model to know if the HMI is currently plugged in. If the HMI is missing the vehicle will know to use default values";
CM_ SG_ 112 HMI_Fail "This signal will be dedicated for failures that can possibly leave the HMI unusable.

";
CM_ SG_ 112 HMI_DrvMode_RQ "Controls the Driven Motors. Signal Generated from within the HMI and shall be sent to the VCM ECU. ";
CM_ SG_ 112 HMI_CreepMode_RQ "Controls Creep Mode Requests. Signal Generated within the HMI and shall be sent to the VCM ECU.";
