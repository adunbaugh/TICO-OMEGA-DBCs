CM_ BO_ 3221225472 "This is a message for not used signals, created by Vector CANdb++ DBC OLE DB Provider.";
CM_ SG_ 3221225472 CAN_Gateway_Enable_Proprietary_2 "Enables heater update gateway for current ignition cycle";
CM_ SG_ 3221225472 CAN_Gateway_Enable_Proprietary_1 "Enables compressor update gateway for current ignition cycle";
CM_ SG_ 3221225472 CAN_Gateway_Enable_Public "Enables pre-defined public CAN gatewayed to private CAN unmodified
Gateway disables when command is not received for 10 consecutive seconds ";
CM_ SG_ 3221225472 CAN_Gateway_Enable_Private "Enables pre-defined private CAN gateway to public CAN unmodified
Gateway disables when command is not received for 10 consecutive seconds ";
CM_ SG_ 2562654206 CAN_Gateway_Public_Status "Status of pre-defined public CAN gateway to private CAN";
CM_ SG_ 2562654206 CAN_Gateway_Proprietary_2_Status "Status of heater update CAN gateway";
CM_ SG_ 2562654206 CAN_Gateway_Proprietary_1_Status "Status of compressor update CAN gateway";
CM_ SG_ 2562654206 CAN_Gateway_Private_Status "Status of pre-defined private CAN gateway to public CAN";
CM_ SG_ 2562588670 DFES_fault_memory "Indicates how many faults are currently held in the Diagnostic Fault Event Storage (DFES). Includes both active and previously active. Maximum is 32.";
CM_ SG_ 2562588670 fault_code "Inidicates the highest active fault number. A return of 0 indicates that no faults are active.";
CM_ SG_ 2562588670 firmware_rev_number "This is the second number in our firmware file name. For example, if the firmware file is 40BF00220033, this signal would return 33.";
CM_ SG_ 2562588670 firmware_id_number "This is the first number in our firmware file name. For example, if the firmware file is 40BF00220033, this signal would return 22.";
CM_ SG_ 2561999609 OVR_pe_pump_speed_command "Transmit 0xFF to disable";
CM_ SG_ 2561999609 OVR_cab_pump_speed_command "Transmit 0xFF to disable";
CM_ SG_ 2561999609 OVR_PWM1_COND_fans "3% - Fan off
20% - Fan reverse
40% - Minimum forward speed
90%+ - Maximum forward speed";
CM_ SG_ 2561999609 OVR_batt_pump_speed_command "Transmit 0xFF to disable";
CM_ SG_ 2562392062 pump_2_average_power "May be used for low flow detection";
CM_ SG_ 2562392062 pump_1_average_power "May be used for low flow detection";
